---
import { Image } from "astro:assets";
import sunShelfImage from "../assets/hero_option2.png";

const pillars = [
  {
    title: "Personal, not transactional",
    copy: "You're trusting us with more than a yard. We treat every project like it's our own backyard.",
  },
  {
    title: "Honest, upfront pricing",
    copy: "Luxury design and real craftsmanship, priced so it's actually within reach for your family.",
  },
  {
    title: "Built to last for years",
    copy: "Quality materials and careful construction mean a pool that holds up long after the last stone is set.",
  },
];
---

<section class="bg-cream py-24 md:py-32">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-2 lg:gap-20 lg:px-10">
    <div class="order-2 lg:order-1">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-ember-dark">Our Approach</p>
      <h2 class="mt-4 font-display text-4xl font-medium leading-tight text-ink text-balance md:text-5xl">
        A luxury pool and yard doesn&rsquo;t have to break the bank
      </h2>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-ink/70 md:text-lg">
        We started Fireside Pools to build outdoor spaces families can
        actually enjoy for years to come &mdash; a place to make memories,
        unwind, and spend time together. Beautiful design, real craftsmanship,
        and honest pricing, all in one build.
      </p>

      <div class="mt-12 space-y-8">
        {pillars.map((pillar) => (
          <div class="flex gap-4">
            <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span>
            <div>
              <h3 class="font-display text-lg font-medium text-ink">{pillar.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink/65 md:text-base">{pillar.copy}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <div class="relative overflow-hidden rounded-2xl shadow-2xl shadow-ink/20">
        <Image
          src={sunShelfImage}
          alt="Pool with in-water lounge chairs and a raised stacked-stone wall, framed by a covered stone patio, designed and built by Fireside Pools"
          class="aspect-[4/5] w-full object-cover md:aspect-[3/4]"
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 40vw, 90vw"
        />
      </div>
    </div>
  </div>
</section>
