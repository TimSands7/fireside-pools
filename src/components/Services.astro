---
const services = [
  {
    title: "Custom Pool Design & Construction",
    copy: "Gunite pools designed around how your family actually lives — from clean rectangles to freeform lagoon shapes.",
  },
  {
    title: "Spas & Hot Tubs",
    copy: "Attached spas, raised walls, and sheer-descent water features that turn a pool into a year-round retreat.",
  },
  {
    title: "Hardscape & Patios",
    copy: "Travertine, stacked stone, and concrete decking built to handle real life and still look incredible.",
  },
  {
    title: "Landscape & Outdoor Living",
    copy: "Turf, plantings, lighting, fencing, and covered pavilions that finish the space, not just the pool.",
  },
];
---

<section id="services" class="bg-cream-soft py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mb-16 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-ember-dark">What We Build</p>
      <h2 class="mt-4 font-display text-4xl font-medium leading-tight text-ink text-balance md:text-5xl">
        One team, from first sketch to first swim
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service, i) => (
        <div class="group rounded-2xl border border-ink/10 bg-cream p-8 transition-colors hover:border-ember/40">
          <span class="font-display text-3xl font-medium text-ember-dark">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-6 font-display text-xl font-medium leading-snug text-ink">
            {service.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">{service.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>
